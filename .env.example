# Секреты (обязательно)
BOT_TOKEN=
BOT_USERNAME=

# --- LLM ---
# Достаточно ОДНОГО ключа. Порядок перебора задаёт LLM_CHAIN.
# Если провайдер вернул ошибку (лимит/401/таймаут), запрос уходит к следующему.

# Бесплатный вариант №1: OpenRouter (openrouter.ai/keys)
# Модели с суффиксом :free не тарифицируются.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Бесплатный вариант №2: Groq (console.groq.com/keys) — быстрый, щедрый лимит
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Основной провайдер: любой OpenAI-совместимый (OpenAI, DeepSeek, свой сервер).
# Оставьте пустым, если хватает OpenRouter/Groq.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Порядок перебора: primary,openrouter,groq
LLM_CHAIN=primary,openrouter,groq
LLM_TIMEOUT=60
LLM_MAX_TOKENS=900

# Данные
DATA_DIR=./data
# DB_PATH=./data/mita.db

# Mini App
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Внутренний адрес, если бот и webapp за одним прокси
# WEBAPP_URL=
# Публичный https-адрес (ngrok / cloudflared). Пусто = кнопка Mini App не показывается
WEBAPP_PUBLIC_URL=

# RAG
# auto | embeddings | tfidf | keywords
RAG_ENGINE=auto
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=4

# Прочее
DEFAULT_TZ=Europe/Moscow
LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
