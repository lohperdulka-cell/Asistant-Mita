# ============================================================
#  МИТА — настройки
#
#  ЗАПОЛНИТЬ НУЖНО 3 СТРОКИ.
#  Они помечены комментарием:   # <<< ВСТАВЬ СЮДА
#  Вписывать нужно В СТРОКУ ПОД ЭТИМ КОММЕНТАРИЕМ, после знака "=".
#  Остальное уже настроено — не трогай.
# ============================================================


# ------------------------------------------------------------
#  [1] ТОКЕН БОТА — обязательно
#      Где взять: Telegram -> @BotFather -> /mybots -> выбрать бота -> API Token
#      Как выглядит: 1234567890:AAHxxxxxxxxxxxxxxxxxxxxxx
#      Без кавычек, без пробелов, в одну строку.
# ------------------------------------------------------------
BOT_TOKEN=


# ------------------------------------------------------------
#  [2] ИМЯ БОТА без @ — обязательно
#      Где взять: @BotFather -> /mybots -> выбрать бота -> @username
#      Пример: Asistentmit_bot
#      Нужно для inline-режима (@упоминание в любом чате).
# ------------------------------------------------------------
BOT_USERNAME=


# ------------------------------------------------------------
#  [3] КЛЮЧ LLM — обязательно, нужен ОДИН из двух вариантов
#
#      ВАРИАНТ А (рекомендую) — OpenRouter
#        Где взять: https://openrouter.ai/keys -> Create Key
#        Как выглядит: sk-or-v1-xxxxxxxx...
#        # <<< ВСТАВЬ КЛЮЧ OPENROUTER СЮДА (строка ниже)
# ------------------------------------------------------------
OPENROUTER_API_KEY=

#      Модель OpenRouter. Менять не нужно.
OPENROUTER_MODEL=google/gemma-4-31b-it:free


# ------------------------------------------------------------
#      ВАРИАНТ Б — Groq (запасной, по желанию)
#        Где взять: https://console.groq.com/keys -> Create API Key
#        Как выглядит: gsk_xxxxxxxx...
#        Не нужен — оставь строку пустой.
#        # <<< ВСТАВЬ КЛЮЧ GROQ СЮДА (строка ниже)
# ------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# ============================================================
#  НИЖЕ МЕНЯТЬ НЕ НУЖНО — значения рабочие для Termux
# ============================================================

# Порядок, в котором бот пробует провайдеров.
LLM_CHAIN=primary,openrouter,groq
LLM_TIMEOUT=60
LLM_MAX_TOKENS=900

# Где хранить базу и загруженные файлы.
DATA_DIR=./data

# Mini App — внутренний адрес.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# Публичный https-адрес Mini App.
# Пусто = кнопка Mini App не показывается (бот работает и без неё).
# Заполняется сам скриптом scripts/run_tunnel.sh.
WEBAPP_PUBLIC_URL=

# Поиск по материалам: auto | embeddings | tfidf | keywords
RAG_ENGINE=auto
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=4

# Часовой пояс для напоминаний и сводки.
# Список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DEFAULT_TZ=Europe/Moscow

LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
